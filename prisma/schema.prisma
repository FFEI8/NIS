// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ 系统管理模块 ============

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  avatar    String?
  phone     String?
  email     String?
  dept      String?
  status    Int      @default(1) // 1=启用 0=禁用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     UserRole[]
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sort        Int      @default(0)
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
  menus       RoleMenu[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   // menu=菜单按钮 api=接口权限
  module      String?  // 所属模块
  description String?
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       RolePermission[]
}

model Menu {
  id        String   @id @default(cuid())
  parentId  String?
  name      String
  code      String   @unique
  path      String?
  icon      String?
  component String?  // 低代码：组件标识
  sort      Int      @default(0)
  type      String   // directory=目录 menu=菜单 button=按钮
  visible   Int      @default(1) // 1=显示 0=隐藏
  status    Int      @default(1) // 1=启用 0=禁用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children  Menu[]   @relation("MenuTree")
  parent    Menu?    @relation("MenuTree", fields: [parentId], references: [id])
  roles     RoleMenu[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleMenu {
  roleId String
  menuId String
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
}

// ============ 感染监测模块 ============

model InfectionCase {
  id              String   @id @default(cuid())
  patientId       String
  patientName     String
  gender          String
  age             Int
  dept            String
  bedNo           String?
  admissionDate   DateTime
  infectionDate   DateTime
  infectionSite   String
  infectionType   String?
  pathogen        String?
  outcome         String?  // 治愈/好转/未愈/死亡
  outcomeDate     DateTime?
  reporter        String?
  status          String   @default("待审核") // 待审核/已确认/已排除
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WarningRecord {
  id              String   @id @default(cuid())
  patientId       String
  patientName     String
  dept            String
  warningType     String   // 病例预警/聚集预警/暴发预警
  warningLevel    String   // 高/中/低
  description     String
  status          String   @default("待处理") // 待处理/已确认/已排除/已处理
  handler         String?
  handleResult    String?
  handleTime      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EnvironmentalMonitor {
  id              String   @id @default(cuid())
  dept            String
  samplePoint     String
  sampleType      String   // 空气/物体表面/医务人员手
  sampleDate      DateTime
  sampler         String?
  result          String?  // 合格/不合格
  colonyCount     Float?
  standardLimit   Float?
  reviewer        String?
  reviewStatus    String   @default("待审核") // 待审核/已审核/退回
  reviewComment   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SterilizationMonitor {
  id              String   @id @default(cuid())
  batchNo         String
  sterilizer      String?
  method          String   // 高压蒸汽/环氧乙烷/等离子
  temperature     Float?
  pressure        Float?
  duration        Float?
  operator        String?
  sterilizeDate   DateTime
  bioResult       String?  // 合格/不合格
  chemResult      String?
  status          String   @default("待检测") // 待检测/合格/不合格
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OccupationalExposure {
  id              String   @id @default(cuid())
  staffName       String
  staffDept       String
  exposureType    String   // 针刺伤/血液体液暴露/其他
  exposureSource  String?
  exposurePart    String
  exposureDate    DateTime
  emergencyAction String?
  riskLevel       String?  // 高/中/低
  followUpPlan    String?
  followUpResult  String?
  status          String   @default("已上报") // 已上报/评估中/随访中/已结案
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AntibioticUsage {
  id              String   @id @default(cuid())
  dept            String
  month           String   // 2024-01
  totalPatients   Int
  antibioticPatients Int
  usageRate       Float
  ddd             Float?   // 抗菌药物使用强度
  preOpProphylaxisRate Float?  // 清洁手术预防用药率
  preOpTimingRate Float?   // 术前0.5-1h给药率
  postOp24hStopRate Float? // 术后24h停药率
  pathogenSendRate Float?  // 治疗用药前送检率
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HandHygiene {
  id              String   @id @default(cuid())
  dept            String
  month           String
  totalOpportunities Int
  compliantActions Int
  complianceRate  Float
  beforeContact   Float?   // 接触患者前
  beforeAseptic   Float?   // 清洁无菌操作前
  afterContact    Float?   // 接触患者后
  afterFluid      Float?   // 接触体液后
  afterSurrounding Float?  // 接触患者周围环境后
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InfectionReport {
  id              String   @id @default(cuid())
  title           String
  type            String   // 日报/周报/月报/季报/年报/专项
  period          String
  content         String
  author          String?
  status          String   @default("草稿") // 草稿/已提交/已审核
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ 传染病管理模块 ============

model InfectiousDiseaseCase {
  id                String   @id @default(cuid())
  patientId         String
  patientName       String
  gender            String
  age               Int
  idCard            String?  // 身份证号
  phone             String?  // 联系电话
  address           String?  // 现住址
  dept              String   // 报告科室
  bedNo             String?
  admissionDate     DateTime? // 入院日期
  onsetDate         DateTime? // 发病日期
  diagnosisDate     DateTime  // 诊断日期
  reportDate        DateTime  @default(now()) // 报告日期
  diseaseName       String   // 传染病名称
  diseaseCode       String?  // ICD-10编码
  diseaseCategory   String   // 甲类/乙类/丙类/其他
  reportType        String   @default("初次报告") // 初次报告/订正报告/转归报告
  infectionSource   String?  // 感染来源
  clinicalDiagnosis String?  // 临床诊断
  labResult         String?  // 实验室检测结果
  severity          String   @default("普通") // 轻症/普通/重症/危重症
  outcome           String?  // 治愈/好转/未愈/死亡/其他
  outcomeDate       DateTime?
  isolationType     String?  // 居家隔离/集中隔离/住院隔离/无需隔离
  isolationDate     DateTime?
  reporter          String?  // 报告人
  reviewer          String?  // 审核人
  reviewComment     String?  // 审核意见
  status            String   @default("待审核") // 待审核/已审核/退回/已上报/已结案
  reportToCDC       Int      @default(0) // 是否已上报CDC 0=否 1=是
  reportToCDCTime   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactTracing {
  id                String   @id @default(cuid())
  caseId            String   // 关联的传染病病例ID
  casePatientName   String   // 病例患者姓名
  contactName       String   // 接触者姓名
  contactIdCard     String?  // 接触者身份证号
  contactPhone      String?  // 接触者电话
  contactAddress    String?  // 接触者住址
  gender            String?
  age               Int?
  relationship      String   // 与患者关系：家属/同事/同病室/医护/其他
  contactType       String   // 密切接触/一般接触
  contactDate       DateTime // 接触日期
  contactDuration   String?  // 接触时长
  contactLocation   String?  // 接触地点
  exposureLevel     String   // 高/中/低
  symptomStatus     String   @default("无症状") // 无症状/有症状/已确诊
  symptomDetail     String?  // 症状详情
  quarantineType    String?  // 居家隔离/集中隔离/自我健康监测/无需隔离
  quarantineStart   DateTime?
  quarantineEnd     DateTime?
  testResult        String?  // 阴性/阳性/未检测
  testDate          DateTime?
  followUpStatus    String   @default("待随访") // 待随访/随访中/已解除/已转确诊
  followUpPerson    String?  // 随访人
  lastFollowUpDate  DateTime?
  remark            String?
  status            String   @default("待确认") // 待确认/已确认/已排除/已解除
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SymptomSurveillance {
  id                String   @id @default(cuid())
  dept              String   // 科室
  patientId         String?  // 患者ID（可为门诊患者）
  patientName       String
  gender            String?
  age               Int?
  temperature       Float?   // 体温
  symptomGroup      String   // 症状群：发热/腹泻/皮疹/呼吸道/神经系统/出血热/其他
  symptomDetail     String   // 症状详情
  onsetDate         DateTime // 发病日期
  reportDate        DateTime @default(now())
  reporter          String?  // 报告人
  isClustered       Int      @default(0) // 是否聚集性 0=否 1=是
  clusterId         String?  // 聚集性事件ID
  alertTriggered    Int      @default(0) // 是否触发预警 0=否 1=是
  alertId           String?  // 关联预警ID
  preliminaryJudge  String?  // 初步判断
  handlingMeasure   String?  // 处置措施
  status            String   @default("待核实") // 待核实/已核实/排除/已预警
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============ 微生物检验数据模块 ============

model MicroLabResult {
  id              String   @id @default(cuid())
  testId          String?  // 检验ID
  patientId       String   // 患者ID
  patientName     String?  // 患者姓名
  visitId         String?  // 住院号
  orderNo         String?  // 医嘱号
  dept            String?  // 科室
  bedNo           String?  // 床号
  specimenType    String   // 标本类型：痰液/尿液/血液/分泌物/肺泡灌洗液等
  specimenNo      String?  // 标本编号
  collectTime     DateTime? // 采集时间
  receiveTime     DateTime? // 接收时间
  reportTime      DateTime? // 报告时间
  reportItemName  String   // 检验项目名称（如：鲍曼不动杆菌[CRAB]）
  reportItemCode  String?  // 检验项目编码
  resultValue     String?  // 结果值（如：≥10^5CFU/ml, +++）
  resultText      String?  // 结果文本
  unit            String?  // 单位
  referenceRange  String?  // 参考范围
  isAbnormal      Int      @default(0) // 是否异常 0=否 1=是
  isMDRO          Int      @default(0) // 是否多重耐药菌 0=否 1=是
  mdroType        String?  // 耐药菌类型：CRAB/CRKP/MRSA/VRE/CRPA等
  organismName    String?  // 菌名
  antibioticResult String? // 药敏结果（JSON格式）
  instrument      String?  // 检测仪器
  operator        String?  // 操作者/报告人
  reviewer        String?  // 审核人
  remarks         String?  // 备注
  warningTriggered Int     @default(0) // 是否已触发预警 0=否 1=是
  warningId       String?  // 关联预警ID
  status          String   @default("已审核") // 待审核/已审核/退回
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WarningRuleLog {
  id              String   @id @default(cuid())
  ruleId          String   // 规则ID
  ruleName        String   // 规则名称
  ruleCode        String   // 规则编码
  triggerSource   String   // 触发来源：micro_lab/infection_case/symptom/environment
  sourceId        String?  // 触发源记录ID
  sourceType      String?  // 触发源类型
  sourceDetail    String?  // 触发源详情（JSON）
  patientId       String?  // 患者ID
  dept            String?  // 科室
  warningLevel    String   // 预警级别
  warningType     String   // 预警类型
  actionTaken     String   // 执行的动作：notify/escalate/block
  actionResult    String?  // 动作执行结果
  warningRecordId String?  // 关联的预警记录ID
  status          String   @default("已触发") // 已触发/已处理/已忽略
  handler         String?  // 处理人
  handleResult    String?  // 处理结果
  handleTime      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ 预警规则配置模块 ============

model WarningRule {
  id                String   @id @default(cuid())
  name              String   // 规则名称
  code              String   @unique // 规则编码
  category          String   // 规则分类：感染监测/传染病管理/环境监测/职业安全/症状监测
  ruleType          String   // 规则类型：阈值预警/趋势预警/聚集预警/时效预警/复合规则
  description       String   // 规则描述
  conditionType     String   // 条件类型：大于/小于/等于/包含/趋势上升/趋势下降/时间超限
  conditionField    String   // 监测字段（如 infectionRate, caseCount, colonyCount 等）
  conditionOperator String   // 运算符：gt/lt/eq/gte/lte/contains/rising/falling/timeout
  conditionValue    String   // 阈值/条件值
  timeWindow        Int      @default(24) // 时间窗口（小时）
  warningLevel      String   @default("中") // 触发预警级别：高/中/低
  warningType       String   @default("病例预警") // 预警类型：病例预警/聚集预警/暴发预警/环境预警/职业暴露预警
  targetDepts       String?  // 适用科室（逗号分隔，空=全部科室）
  targetSites       String?  // 适用感染部位（逗号分隔）
  targetDiseases    String?  // 适用传染病（逗号分隔）
  actionType        String   @default("notify") // 触发动作：notify=通知/escalate=升级/block=阻断
  actionConfig      String?  // 动作配置（JSON格式，如通知人列表、升级规则等）
  cooldownMinutes   Int      @default(60) // 冷却时间（分钟），同一规则重复触发的最小间隔
  priority          Int      @default(0) // 优先级，数值越大优先级越高
  isSystem          Int      @default(0) // 是否系统内置规则 0=否 1=是（系统规则不可删除）
  enabled           Int      @default(1) // 是否启用 0=禁用 1=启用
  triggerCount      Int      @default(0) // 累计触发次数
  lastTriggeredAt   DateTime? // 最后触发时间
  createdBy         String?  // 创建人
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DiseaseAlert {
  id                String   @id @default(cuid())
  alertType         String   // 法定传染病预警/聚集性疫情预警/症状监测预警/输入性传染病预警
  alertLevel        String   // 红色/橙色/黄色/蓝色
  diseaseName       String?  // 传染病名称
  alertSource       String   // 病例上报/症状监测/系统自动/人工上报
  triggerRule       String?  // 触发规则描述
  relatedCaseIds    String?  // 关联病例ID（逗号分隔）
  relatedSymptomIds String?  // 关联症状监测ID（逗号分隔）
  affectedDept      String?  // 涉及科室
  affectedCount     Int      @default(0) // 涉及人数
  description       String   // 预警描述
  suggestion        String?  // 处置建议
  handler           String?  // 处理人
  handleResult      String?  // 处理结果
  handleTime        DateTime?
  status            String   @default("待处理") // 待处理/处理中/已处理/已关闭
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
